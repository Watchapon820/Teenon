PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=teenon_db
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated trusted web origins (e.g. https://app.example.com); localhost is allowed outside production.
CORS_ORIGINS=

# ชำระเงิน: PromptPay (เบอร์มือถือหรือเลขบัตรประชาชน 13 หลัก) จะสร้าง QR พร้อมยอดให้อัตโนมัติ
PROMPTPAY_ID=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=

# ข้อมูลติดต่อที่แสดงในแอป (หน้า "ติดต่อเรา")
CONTACT_PHONE=
CONTACT_LINE=
CONTACT_EMAIL=
CONTACT_HOURS=

# อีเมลสำหรับส่งรหัสยืนยันตอนลืมรหัสผ่าน (เช่น Gmail: smtp.gmail.com / 587 + App Password)
# ถ้าไม่ตั้ง ระบบจะพิมพ์รหัสยืนยันลง Terminal ของ server แทน (ใช้ตอนพัฒนาเท่านั้น)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ตั้งเป็น 1 เมื่อรันหลัง reverse proxy ที่ทำ HTTPS (Caddy/nginx)
TRUST_PROXY=
